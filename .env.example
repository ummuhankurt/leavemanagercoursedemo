# Settings are read from ENVIRONMENT VARIABLES only — the app does not load a .env file (yet).
# Set them in your shell, e.g.  export LEAVE_MANAGER_DATABASE_URL=sqlite:///./leave_manager.db
# Never commit real values (docs/security.md, Secrets).
# SQLite database used by the running app (default below; tests use their own temporary database).
LEAVE_MANAGER_DATABASE_URL=sqlite:///./leave_manager.db
