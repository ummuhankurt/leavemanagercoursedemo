# Settings are read from ENVIRONMENT VARIABLES only — the app does not load a .env file (yet).
# Set them in your shell, e.g.  export LEAVE_MANAGER_DATABASE_URL=sqlite:///./leave_manager.db
# Never commit real values (docs/security.md, Secrets).
# SQLite database used by the running app (default below; tests use their own temporary database).
LEAVE_MANAGER_DATABASE_URL=sqlite:///./leave_manager.db
# REQUIRED: signs session cookies; the app refuses to start without it (spec 0002).
# Use a long random value, e.g.  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
LEAVE_MANAGER_SESSION_SECRET=change-me
# Production behind HTTPS: true → the session cookie gets the Secure flag. Local http: false.
LEAVE_MANAGER_COOKIE_SECURE=false
# Seed only (uv run python -m leave_manager.seed): password for the demo users. Never commit it.
LEAVE_MANAGER_DEMO_PASSWORD=change-me
